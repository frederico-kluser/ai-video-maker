{
  "title": "Documento de Autoria v1 (subset OpenAI strict)",
  "description": "Subset do schema de autoria v1 (autoria.schema.json) podado para o strict da OpenAI (response_format json_schema). Regras do modo estrito da OpenAI, aplicadas aqui: TODAS as propriedades em required (opcional emulado com uniao null: [\"string\",\"null\"]), additionalProperties:false em todo objeto, raiz objeto (nunca anyOf), sem allOf/not/if/then/else/dependent*. Recursao e suportada pela OpenAI mas nao usada (profundidade fixa do v1). As invariantes de negocio vivem apenas no schema completo (autoria.schema.json), contra o qual a resposta e validada.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "nos",
    "cenas",
    "audio"
  ],
  "properties": {
    "schema_version": {
      "const": "Autoria.1"
    },
    "nos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/No"
      }
    },
    "cenas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/Cena"
      }
    },
    "audio": {
      "anyOf": [
        { "$ref": "#/$defs/Audio" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "No": {
      "description": "No narrativo — uniao discriminada por anyOf de objetos, cada um com type: const. Nenhum ramo carrega frame, cor, coordenada, layout ou duracao: o sistema decide.",
      "anyOf": [
        { "$ref": "#/$defs/NoCabecalho" },
        { "$ref": "#/$defs/NoTexto" },
        { "$ref": "#/$defs/NoLista" },
        { "$ref": "#/$defs/NoMidia" },
        { "$ref": "#/$defs/NoCodigo" },
        { "$ref": "#/$defs/NoGrafico" }
      ]
    },
    "NoCabecalho": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema",
        "type",
        "texto",
        "subtitulo"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "schema": {
          "const": "Cabecalho.1"
        },
        "type": {
          "const": "cabecalho"
        },
        "texto": {
          "type": "string",
          "minLength": 1
        },
        "subtitulo": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "NoTexto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema",
        "type",
        "texto",
        "destaque"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "schema": {
          "const": "Texto.1"
        },
        "type": {
          "const": "texto"
        },
        "texto": {
          "type": "string",
          "minLength": 1
        },
        "destaque": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },
    "NoLista": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema",
        "type",
        "itens",
        "ordenada"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "schema": {
          "const": "Lista.1"
        },
        "type": {
          "const": "lista"
        },
        "itens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ordenada": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },
    "NoMidia": {
      "description": "AB-432: hash e ADVISORY — ausencia do hash e valida (o hash e resolvido a jusante, na fronteira de resolucao). AB-433: texto_alternativo e OBRIGATORIO — um no de midia sem descricao e invalido, erro e nao aviso.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema",
        "type",
        "tipo_midia",
        "texto_alternativo",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "schema": {
          "const": "Midia.1"
        },
        "type": {
          "const": "midia"
        },
        "tipo_midia": {
          "type": "string",
          "enum": [
            "imagem",
            "video",
            "gif"
          ]
        },
        "texto_alternativo": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "anyOf": [
            { "type": "string", "description": "ADVISORY (AB-432): quando presente, registrado; ausencia nunca reprova." },
            { "type": "null" }
          ]
        }
      }
    },
    "NoCodigo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema",
        "type",
        "codigo",
        "linguagem",
        "linhas_destaque"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "schema": {
          "const": "Codigo.1"
        },
        "type": {
          "const": "codigo"
        },
        "codigo": {
          "type": "string",
          "minLength": 1
        },
        "linguagem": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "linhas_destaque": {
          "anyOf": [
            { "type": "array", "maxItems": 20, "items": { "type": "integer" } },
            { "type": "null" }
          ]
        }
      }
    },
    "NoGrafico": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema",
        "type",
        "tipo_grafico",
        "titulo",
        "dados"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "schema": {
          "const": "Grafico.1"
        },
        "type": {
          "const": "grafico"
        },
        "tipo_grafico": {
          "type": "string",
          "enum": [
            "barras",
            "linha",
            "pizza",
            "area",
            "dispersao"
          ]
        },
        "titulo": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "dados": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rotulo",
              "valor"
            ],
            "properties": {
              "rotulo": {
                "type": "string",
                "minLength": 1
              },
              "valor": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "Transicao": {
      "description": "Vocabulario FECHADO de apresentacao de transicao. O tipo e decisao narrativa de ritmo; a DURACAO (frames) e a direcao sao decisao do sistema e nao existem aqui.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "fade",
            "slide",
            "wipe",
            "flip",
            "none"
          ]
        }
      }
    },
    "AudioCena": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texto_locucao"
      ],
      "properties": {
        "texto_locucao": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Cena": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nos",
        "transicao_entrada",
        "transicao_saida",
        "audio_cena"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "nos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "transicao_entrada": {
          "anyOf": [
            { "$ref": "#/$defs/Transicao" },
            { "type": "null" }
          ]
        },
        "transicao_saida": {
          "anyOf": [
            { "$ref": "#/$defs/Transicao" },
            { "type": "null" }
          ]
        },
        "audio_cena": {
          "anyOf": [
            { "$ref": "#/$defs/AudioCena" },
            { "type": "null" }
          ]
        }
      }
    },
    "Audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trilha_sonora"
      ],
      "properties": {
        "trilha_sonora": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
