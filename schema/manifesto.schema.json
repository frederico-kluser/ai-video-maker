{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-maker/schema/manifesto.schema.json",
  "title": "Manifesto de Video",
  "description": "Schema de validacao completo (draft 2020-12) do manifesto de video. Contem todas as invariantes numericas e de tamanho. O schema entregue ao LLM e um subset deste (manifesto.llm.schema.json), sem constraints de validacao.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fps",
    "width",
    "height",
    "nos",
    "cenas"
  ],
  "properties": {
    "schema_version": {
      "const": "Manifesto.1"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "default": 30
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "default": 1920
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "default": 1080
    },
    "duracao_total_frames": {
      "type": "integer",
      "minimum": 1
    },
    "nos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/No"
      }
    },
    "cenas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Cena"
      }
    },
    "audio": {
      "$ref": "#/$defs/Audio"
    }
  },
  "$defs": {
    "No": {
      "description": "No visual — uniao discriminada por anyOf + const no campo type",
      "anyOf": [
        {
          "$ref": "#/$defs/NoCabecalho"
        },
        {
          "$ref": "#/$defs/NoTexto"
        },
        {
          "$ref": "#/$defs/NoLista"
        },
        {
          "$ref": "#/$defs/NoMidia"
        },
        {
          "$ref": "#/$defs/NoCodigo"
        },
        {
          "$ref": "#/$defs/NoGrafico"
        }
      ]
    },
    "NoBase": {
      "type": "object",
      "required": [
        "id",
        "schema",
        "type",
        "duracao_frames"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador unico do no. Referenciado pelas cenas."
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "description": "Versao do schema deste no. Formato: <NomeDoTipo>.<N>"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Tipo do no visual. Usado para discriminar a uniao anyOf."
        },
        "duracao_frames": {
          "type": "integer",
          "minimum": 1,
          "description": "Duracao do no em frames."
        },
        "entrada_frames": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Offset de entrada em frames a partir do inicio da cena."
        },
        "animacao": {
          "$ref": "#/$defs/Animacao"
        }
      }
    },
    "Animacao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "fade",
            "slide",
            "scale",
            "spring",
            "none"
          ]
        },
        "direcao": {
          "type": "string",
          "enum": [
            "from-left",
            "from-right",
            "from-top",
            "from-bottom"
          ]
        },
        "duracao_frames": {
          "type": "integer",
          "minimum": 0
        },
        "configuracao_mola": {
          "$ref": "#/$defs/ConfiguracaoMola"
        }
      }
    },
    "ConfiguracaoMola": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "damping",
        "stiffness"
      ],
      "properties": {
        "damping": {
          "type": "number",
          "minimum": 0
        },
        "stiffness": {
          "type": "number",
          "minimum": 0
        },
        "mass": {
          "type": "number",
          "minimum": 0,
          "default": 1
        }
      }
    },
    "NoCabecalho": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/NoBase"
        },
        {
          "properties": {
            "type": {
              "const": "cabecalho"
            },
            "schema": {
              "const": "Cabecalho.1"
            },
            "texto": {
              "type": "string",
              "minLength": 1
            },
            "subtitulo": {
              "type": "string"
            },
            "alinhamento": {
              "type": "string",
              "enum": [
                "esquerda",
                "centro",
                "direita"
              ],
              "default": "centro"
            }
          },
          "required": [
            "texto"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "NoTexto": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/NoBase"
        },
        {
          "properties": {
            "type": {
              "const": "texto"
            },
            "schema": {
              "const": "Texto.1"
            },
            "texto": {
              "type": "string",
              "minLength": 1
            },
            "destaque": {
              "type": "boolean",
              "default": false
            },
            "alinhamento": {
              "type": "string",
              "enum": [
                "esquerda",
                "centro",
                "direita"
              ],
              "default": "esquerda"
            }
          },
          "required": [
            "texto"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "NoLista": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/NoBase"
        },
        {
          "properties": {
            "type": {
              "const": "lista"
            },
            "schema": {
              "const": "Lista.1"
            },
            "itens": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "ordenada": {
              "type": "boolean",
              "default": false
            },
            "alinhamento": {
              "type": "string",
              "enum": [
                "esquerda",
                "centro",
                "direita"
              ],
              "default": "esquerda"
            }
          },
          "required": [
            "itens"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "NoMidia": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/NoBase"
        },
        {
          "properties": {
            "type": {
              "const": "midia"
            },
            "schema": {
              "const": "Midia.1"
            },
            "hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "description": "SHA-256 do conteudo do asset (hex, minusculas, 64 caracteres)"
            },
            "tipo_midia": {
              "type": "string",
              "enum": [
                "imagem",
                "video",
                "gif"
              ]
            },
            "ajuste": {
              "type": "string",
              "enum": [
                "cover",
                "contain",
                "fill",
                "none"
              ],
              "default": "cover"
            },
            "texto_alternativo": {
              "type": "string"
            },
            "licenca": {
              "type": "string",
              "minLength": 1,
              "description": "Identificador de licenca do asset"
            }
          },
          "required": [
            "hash",
            "tipo_midia",
            "licenca"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "NoCodigo": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/NoBase"
        },
        {
          "properties": {
            "type": {
              "const": "codigo"
            },
            "schema": {
              "const": "Codigo.1"
            },
            "codigo": {
              "type": "string",
              "minLength": 1
            },
            "linguagem": {
              "type": "string",
              "minLength": 1,
              "default": "text"
            },
            "linhas_destaque": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "nome_arquivo": {
              "type": "string"
            }
          },
          "required": [
            "codigo",
            "linguagem"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "NoGrafico": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/NoBase"
        },
        {
          "properties": {
            "type": {
              "const": "grafico"
            },
            "schema": {
              "const": "Grafico.1"
            },
            "tipo_grafico": {
              "type": "string",
              "enum": [
                "barras",
                "linha",
                "pizza",
                "area",
                "dispersao"
              ]
            },
            "titulo": {
              "type": "string"
            },
            "dados": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rotulo",
                  "valor"
                ],
                "properties": {
                  "rotulo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "valor": {
                    "type": "number"
                  },
                  "cor": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "tipo_grafico",
            "dados"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Cena": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nos"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador unico da cena"
        },
        "nos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Lista ordenada de ids dos nos que compoem a cena. Referencias para a lista plana de nos."
        },
        "transicao_entrada": {
          "$ref": "#/$defs/Transicao"
        },
        "transicao_saida": {
          "$ref": "#/$defs/Transicao"
        },
        "audio_cena": {
          "$ref": "#/$defs/AudioCena"
        }
      }
    },
    "Transicao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "duracao_frames"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "slide",
            "fade",
            "wipe",
            "flip",
            "clockWipe",
            "cube",
            "none"
          ]
        },
        "duracao_frames": {
          "type": "integer",
          "minimum": 0
        },
        "direcao": {
          "type": "string",
          "enum": [
            "from-left",
            "from-right",
            "from-top",
            "from-bottom"
          ]
        },
        "timing": {
          "$ref": "#/$defs/TimingMola"
        }
      }
    },
    "TimingMola": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "spring"
        },
        "config": {
          "$ref": "#/$defs/ConfiguracaoMola"
        }
      }
    },
    "Audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trilha_sonora"
      ],
      "properties": {
        "trilha_sonora": {
          "type": "string",
          "minLength": 1,
          "description": "Hash SHA-256 do arquivo de trilha sonora ou 'none' para sem audio."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3
        },
        "inicio_frames": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "AudioCena": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_locucao"
      ],
      "properties": {
        "hash_locucao": {
          "type": "string",
          "minLength": 1,
          "description": "Hash SHA-256 do arquivo de audio da locucao da cena."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1.0
        },
        "texto_locucao": {
          "type": "string",
          "description": "Texto da locucao para referencia e geracao de legendas."
        }
      }
    }
  }
}
